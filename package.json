{
  "name": "grok-bot-setup",
  "version": "1.3.0",
  "description": "CLI to point Grok Bot at custom model providers (DeepSeek, Claude, Grok, OpenAI, \u2026)",
  "keywords": [
    "grok",
    "xai",
    "adapters",
    "cli",
    "llm",
    "openai-compatible"
  ],
  "homepage": "https://github.com/BlockedPath/grok-bot-setup",
  "bugs": {
    "url": "https://github.com/BlockedPath/grok-bot-setup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlockedPath/grok-bot-setup.git"
  },
  "license": "MIT",
  "author": "BlockedPath",
  "type": "commonjs",
  "bin": {
    "adapters": "adapters.sh",
    "grok-bot-setup": "adapters.sh"
  },
  "files": [
    "adapters",
    "adapters.sh",
    "xai-prompt-session.cjs",
    "xai-inference.env.example",
    "scripts/ensure-xai-inference.sh",
    "scripts/restore-after-reset.sh",
    "scripts/bootstrap.sh",
    "scripts/verify-tool-patch.sh",
    "scripts/preserve-tool-contracts.sh",
    "scripts/restore-tool-contracts.sh",
    "tests/machine-id.cjs",
    "tests/end-turn.cjs",
    "tests/recovery.cjs",
    "tests/host-machine-id.cjs",
    "docs/TOOL_FIX_RECOVERY.md",
    "examples/cliproxy-openai-compat.yaml",
    "docs/GUIDE_CUSTOM_INFERENCE.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=14"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "preferGlobal": true,
  "devDependencies": {
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.5"
  },
  "scripts": {
    "adapters": "bash ./adapters.sh",
    "prepack": "test -x adapters.sh",
    "test": "bash -n adapters.sh && bash -n adapters && bash -n scripts/ensure-xai-inference.sh && bash -n scripts/restore-after-reset.sh && bash -n scripts/bootstrap.sh && bash ./adapters.sh help >/dev/null && node tests/machine-id.cjs && node tests/end-turn.cjs && node tests/recovery.cjs",
    "test:host-machine-id": "node tests/host-machine-id.cjs"
  }
}
