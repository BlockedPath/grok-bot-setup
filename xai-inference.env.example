# Copy to ~/sand-data/xai-inference.env after a reset if you want CLIProxy
# without walking through `adapters use`. Then: adapters recover
#
#   mkdir -p ~/sand-data
#   cp xai-inference.env.example ~/sand-data/xai-inference.env
#   adapters recover
#
SAND_INFERENCE_PROVIDER=xai
XAI_API_KEY=sand-cliproxy
SAND_XAI_BASE_URL=http://127.0.0.1:8317/v1
SAND_XAI_MODEL=claude-opus-5
SAND_XAI_THINKING=disabled
SAND_XAI_IDENTITY=1
